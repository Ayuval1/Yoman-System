{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/ops?task=cron-plan&slot=1", "schedule": "0 1 * * *" },
    { "path": "/api/ops?task=cron-plan&slot=2", "schedule": "0 14 * * *" },
    { "path": "/api/ops?task=daily-check", "schedule": "30 4 * * *" },
    { "path": "/api/ops?task=gate-probe&from=0&model=gemini-3.5-flash-lite", "schedule": "50 4 * * *" }
  ],
  "functions": {
    "api/queues/deliver.js": {
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "daily-slots", "retryAfterSeconds": 60, "maxDeliveries": 5 }]
    }
  },
  "rewrites": [
    { "source": "/api/vapid-public-key", "destination": "/api/push-subscribe" },
    { "source": "/api/cron-plan", "destination": "/api/ops?task=cron-plan" },
    { "source": "/api/daily-check", "destination": "/api/ops?task=daily-check" },
    { "source": "/api/gate-probe", "destination": "/api/ops?task=gate-probe" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
    }
  ]
}
